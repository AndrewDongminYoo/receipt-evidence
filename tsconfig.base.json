{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.test.ts",
    "apps/*/src/**/*.ts",
    "apps/*/app/**/*.ts",
    "apps/*/test/**/*.test.ts"
  ]
}
